<Window x:Class="STecSolutions.Inventario.UI.VentanaAgregar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STecSolutions.Inventario"
        mc:Ignorable="d"
        Title="Registrar Nuevo Equipo" Height="480" Width="450" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Loaded="CargaSegura">

    <Window.Resources>
        <Style x:Key="EstiloBtn" TargetType="Button" BasedOn="{StaticResource MiEstiloBtn}"></Style>
    </Window.Resources>
        
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Código Inventario -->
        <Label Content="Código Inventario:" Grid.Row="0" Grid.Column="0" VerticalContentAlignment="Center" FontWeight="Bold"/>
        <TextBox x:Name="txtCodInventario" Grid.Row="0" Grid.Column="1" Margin="5" Padding="5"/>

        <!-- Tipo de Equipo -->
        <Label Content="Tipo de Equipo:" Grid.Row="1" Grid.Column="0" VerticalContentAlignment="Center" FontWeight="Bold"/>
        <Grid Grid.Row="1" Grid.Column="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="cmbTipo" Grid.Row="0" Grid.Column="0" Padding="5"/>
            <Button x:Name="btnNuevoTipo" Grid.Column="1" Content="+" Width="30" Margin="5,0,0,0" FontWeight="Bold" Foreground="White" Background="#FF339933" Click="btnNuevoTipo_Click"/>
        </Grid>

        <!-- Modelo -->
        <Label Content="Modelo:" Grid.Row="2" Grid.Column="0" VerticalContentAlignment="Center" FontWeight="Bold"/>
        <Grid Grid.Row="2" Grid.Column="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/> 
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="cmbModelo" Grid.Row="0" Grid.Column="0" Padding="5"/>
            <Button x:Name="btnNuevoModelo" Content="+" Grid.Row="0" Grid.Column="1" Width="30" Margin="5,0,0,0" FontWeight="Bold" Foreground="White" Background="#FF339933" Click="btnNuevoModelo_Click"/>
        </Grid>

        <!-- Procesador -->

        <Label Content="Procesador:" Grid.Row="3" Grid.Column="0" VerticalContentAlignment="Center" FontWeight="Bold"/>
        <Grid Grid.Row="3" Grid.Column="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="cmbProcesador" Grid.Row="0" Grid.Column="0" Padding="5"/>
            <Button x:Name="btnNuevoProcesador" Content="+" Grid.Row="0" Grid.Column="1" Width="30" Margin="5,0,0,0" FontWeight="Bold" Foreground="White" Background="#FF339933" Click="btnNuevoProcesador_Click" />
        </Grid>
        
        <!-- Memoria RAM -->
        <Label Content="RAM:" Grid.Row="4" Grid.Column="0" VerticalContentAlignment="Center" FontWeight="Bold"/>
        <TextBox x:Name="txtMemoriaRam" Grid.Row="4" Grid.Column="1" Margin="5" Padding="5"/>

        <!-- Capacidad Almacenamiento -->
        <Label Content="Almacenamiento:" Grid.Row="5" Grid.Column="0" VerticalContentAlignment="Center" FontWeight="Bold"/>
        <TextBox x:Name="txtAlmacenamiento" Grid.Row="5" Grid.Column="1" Margin="5" Padding="5"/>

        <!-- ID Sistema Operativo -->
        <Label Content="Sistema Operativo:" Grid.Row="6" Grid.Column="0" VerticalContentAlignment="Center" FontWeight="Bold"/>
        <Grid Grid.Row="6" Grid.Column="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="cmbSistemaOperativo" Grid.Row="0" Grid.Column="0" Padding="5" />
            <Button x:Name="btnNuevoSistemaOperativo" Content="+" Grid.Row="0" Grid.Column="1" Width="30" Margin="5,0,0,0" FontWeight="Bold" Foreground="White" Background="#FF339933" Click="btnNuevoSistemaOperativo_Click"/>
        </Grid>

        <!-- Usuario ID --> 
        <Label Content="Responsable:" Grid.Row="7" Grid.Column="0" VerticalContentAlignment="Center" FontWeight="Bold"/>
        <Grid Grid.Row="7" Grid.Column="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            
            <ComboBox x:Name="cmbUsuario" Grid.Row="0" Grid.Column="0" Padding="5"/>
            <Button x:Name="btnNuevoUsuario" Grid.Row="0" Grid.Column="1" Content="+" Width="30" Margin="5,0,0,0" FontWeight="Bold" Foreground="white" Background="#FF339933" Click="btnNuevoUsuario_Click" />
        </Grid>

            <!-- Ubicación ID -->
        <Label Content="Ubicación:" Grid.Row="8" Grid.Column="0" VerticalContentAlignment="Center" FontWeight="Bold"/>
        <Grid Grid.Row="8" Grid.Column="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="cmbUbicacion" Grid.Row="0"  Grid.Column="0" Padding="5" />
            <Button x:Name="btnNuevaUbicacion" Grid.Row="0" Grid.Column="1" Content="+" Width="30" Margin="5,0,0,0" FontWeight="Bold" Foreground="White" Background="#FF339933" Click="btnNuevaUbicacion_Click" />
        </Grid>

        <!-- Estado -->
        <Label Content="Estado:" Grid.Row="9" Grid.Column="0" VerticalContentAlignment="Center" FontWeight="Bold"/>
        <Grid Grid.Row="9" Grid.Column="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="cmbEstado" Grid.Row="0" Grid.Column="0" Padding="5"/>
            <Button x:Name="btnNuevoEstado" Grid.Row="0" Grid.Column="1" Content="+" Width="30" Margin="5,0,0,0" FontWeight="Bold" Foreground="White" Background="#FF339933" Click="btnNuevoEstado_Click"/>
        </Grid>

        <!-- Botón Guardar -->
        <Button x:Name="btnRegistrarDatos" Content="Registrar" Grid.Row="10" Grid.Column="1" Margin="0,5,0,0" Background="#FF339933" Style="{StaticResource EstiloBtn}"/> <!-- Click="clickHibrido" -->   

    </Grid>
</Window>
