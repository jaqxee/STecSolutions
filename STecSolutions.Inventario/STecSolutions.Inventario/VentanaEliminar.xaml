<Window x:Class="STecSolutions.Inventario.UI.VentanaEliminar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STecSolutions.Inventario"
        mc:Ignorable="d"
        Title="Ventana Eliminar" Height="220" Width="420" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="EstiloBtn" TargetType="Button" BasedOn="{StaticResource MiEstiloBtn}">
        </Style>
    </Window.Resources>
    
    <Grid Background="#F9F9F9">
        <StackPanel Margin="25" VerticalAlignment="Center">
            <TextBlock x:Name="mensajeEliminar" Text="Está eliminando el equipo con número de serie: xxxx" FontSize="15" FontWeight="Medium" Foreground="#333333" TextAlignment="Center" TextWrapping="Wrap" Margin="0,20,0,0"/>
            <TextBlock Text="¿Está Seguro?" FontSize="16" FontWeight="Bold" Foreground="#C62828" TextAlignment="Center" Margin="0,10,0,10"/>
            <StackPanel Margin="0,10,0,20" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                <Button x:Name="btnConfirmarEliminar" Content="Sí, Eliminar" Style="{StaticResource EstiloBtn}" Background="#C62828"  Click="btnConfirmarEliminar_Click" />
                <Button x:Name="btnCancelarEliminar" Content="Cancelar" Style="{StaticResource EstiloBtn}"  Margin="15,0,0,0" Background="#FF339933" Click="btnCancelarEliminar_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
