<Window x:Class="STecSolutions.Inventario.UI.VentanaAgregarUbicacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STecSolutions.Inventario"
        mc:Ignorable="d"
        Title="Agregar Ubicación" Height="265" Width="400" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FocusManager.FocusedElement="{Binding ElementName=txtUbicacionNueva}">

    <Window.Resources>
        <Style x:Key="EstiloBtn" TargetType="Button" BasedOn="{StaticResource MiEstiloBtn}"></Style>
    </Window.Resources>
    
    <Grid Margin="30,30,30,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
            
         <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Content="Sede:" Grid.Column="0" Grid.Row="0" VerticalContentAlignment="Center" FontWeight="Bold" />
        <TextBox x:Name="txtSede" Grid.Column="1" Grid.Row="0" Margin="5" Padding="5"/>

        <Label Content="Edificio:" Grid.Row="1" Grid.Column="0" VerticalContentAlignment="Center" FontWeight="Bold"/>
        <TextBox x:Name="txtEdificio" Grid.Row="1" Grid.Column="1" Margin="5" Padding="5"/>

        <Label Content="Piso:" Grid.Row="2" Grid.Column="0" VerticalContentAlignment="Center" FontWeight="Bold"/>
        <TextBox x:Name="txtPiso" Grid.Row="2" Grid.Column="1" Margin="5" Padding="5"/>

        <Label Content="Oficina:" Grid.Row="3" Grid.Column="0" VerticalContentAlignment="Center" FontWeight="Bold"/>
        <TextBox x:Name="txtOficina" Grid.Row="3" Grid.Column="1" Margin="5" Padding="5"/>

        <Button x:Name="btnGuardarUbicacionNueva" Content="Guardar Ubicación" Grid.Row="4" Grid.Column="1" Margin="0,5,0,0" HorizontalAlignment="Center" Style="{StaticResource EstiloBtn}" Background="#FF339933" Click="btnGuardarUbicacion_Click"/>
    </Grid>
</Window>
