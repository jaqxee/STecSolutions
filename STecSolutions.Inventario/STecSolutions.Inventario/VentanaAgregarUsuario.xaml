<Window x:Class="STecSolutions.Inventario.VentanaAgregarUsuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STecSolutions.Inventario"
        mc:Ignorable="d"
        Title="Agregar Usuario" Height="230" Width="400" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FocusManager.FocusedElement="{Binding ElementName=txtNombre}">

    <Window.Resources>
        <Style x:Key="EstiloBtn" TargetType="Button" BasedOn="{StaticResource MiEstiloBtn}"></Style>
    </Window.Resources>
    
    <Grid Margin="30,30,30,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label Content="Nombre Completo:" Grid.Row="0" Grid.Column="0" VerticalContentAlignment="Center"  FontWeight="Bold" />
        <TextBox x:Name="txtUNombre" Grid.Row="0" Grid.Column="1" Margin="5" Padding="5" />

        <Label Content="Email:" Grid.Row="1" Grid.Column="0" VerticalContentAlignment="Center" FontWeight="Bold"/>
        <TextBox x:Name="txtUEmail" Grid.Row="1" Grid.Column="1" Margin="5" Padding="5"/>

        <Label Content="Departamento:" Grid.Row="2" Grid.Column="0" VerticalContentAlignment="Center" FontWeight="Bold"/>
        <TextBox x:Name="txtDepartamento" Grid.Row="2" Grid.Column="1" Margin="5" Padding="5"/>

        <Button x:Name="btnGuardarUsuarioNuevo" Content="Guardar Usuario" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Center" Margin="0,5,0,0" Background="#FF339933" Style="{StaticResource EstiloBtn}" Click="btnGuardarUsuario_Click"/>


    </Grid>
</Window>
