<Window x:Class="STecSolutions.Inventario.UI.VentanaInicio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STecSolutions.Inventario"
        mc:Ignorable="d"
        Title="Ventana Principal" Height="450" Width="800" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="EstiloBtn" TargetType="Button" BasedOn="{StaticResource MiEstiloBtn}">
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.Resources>
            <Style TargetType="DataGrid">
                <Setter Property="ColumnWidth" Value="*" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="AlternatingRowBackground" Value="#CBDCCB" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#DDDDDD" />
                <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE" />


                <Style.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FF339933" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Padding" Value="8,5,8,5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </Style.Resources>
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" >
            <Button x:Name="btnRegistrar" Content="Registrar Equipo"   Background="#2E7D32" Style="{StaticResource EstiloBtn}" Click="btnRegistrar_Click"/>
            <Button x:Name="btnConsultar" Content="Consultar Equipo"    Background="#546E7A" Style="{StaticResource EstiloBtn}" Click="btnConsultar_Click"/>
            <Button x:Name="btnActualizar" Content="Actualizar Equipo"   Background="#7CB342" Style="{StaticResource EstiloBtn}" Click="btnActualizar_Click" />
            <Button x:Name="btnEliminar" Content="Eliminar Equipo"   Background="#C62828" Style="{StaticResource EstiloBtn}" Click="btnEliminar_Click"/>
        </StackPanel>
        
        <DataGrid x:Name="dgInventario" Grid.Column="1" Margin="10,10,10,10" CanUserAddRows="False" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código Inventario" Binding="{Binding CodInventario}" Width="*"/>
                <DataGridTextColumn Header="Estado Operativo" Binding="{Binding EstadoOperativo}" Width="*"/>
                <DataGridTextColumn Header="Responsable" Binding="{Binding Responsable}" Width="*"/>
                <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
